#!/bin/sh
# pre-push: scan outgoing commits for secrets and sensitive details (see scripts/check-push.ps1).
# Enable once per clone:  git config core.hooksPath .githooks
# Git passes: $1 = remote name, $2 = remote URL; stdin lines: <local ref> <local sha> <remote ref> <remote sha>

zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref sends no commits.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: scan every commit not already on a remote.
    range="$local_sha --not --remotes=$1"
  else
    range="$remote_sha..$local_sha"
  fi
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-push.ps1 -Range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: blocked by check-push. Fix the findings, or bypass knowingly with 'git push --no-verify'." >&2
fi
exit $status
